<Window x:Class="SiteShield.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SiteShield" Width="900" Height="650" MinWidth="760" MinHeight="560" Background="#0B1220" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="SiteShield" FontSize="34" FontWeight="Bold" Foreground="#F8FAFC"/>
      <TextBlock Text="Windows website allow-list firewall" Foreground="#94A3B8" FontSize="15" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#162033" CornerRadius="14" Padding="18" Margin="0,24,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Protection" Foreground="#94A3B8" FontSize="12"/>
          <TextBlock x:Name="StatusText" Text="Loading..." Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="ApplyButton" Content="Apply protection" Click="ApplyButton_Click" Padding="18,10" Margin="12,0,8,0" Background="#0284C7" Foreground="White" BorderThickness="0"/>
        <Button Grid.Column="2" x:Name="DisableButton" Content="Disable" Click="DisableButton_Click" Padding="18,10" Background="#334155" Foreground="White" BorderThickness="0"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Background="#111827" CornerRadius="14" Padding="18" Margin="0,0,14,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Allowed websites" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Everything else is blocked when protection is enabled." Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Remove selected" Click="RemoveButton_Click" Padding="14,8" Background="#334155" Foreground="White" BorderThickness="0"/>
          </Grid>
          <ListBox x:Name="DomainsList" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" FontSize="15"/>
        </DockPanel>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Background="#111827" CornerRadius="14" Padding="18">
          <StackPanel>
            <TextBlock Text="Add website" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Enter a domain, not https://" Foreground="#94A3B8" Margin="0,4,0,12"/>
            <TextBox x:Name="DomainBox" Height="38" Padding="10" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"/>
            <Button Content="Add to allow list" Click="AddButton_Click" Margin="0,12,0,0" Padding="12,10" Background="#0284C7" Foreground="White" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <Border Background="#111827" CornerRadius="14" Padding="18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Browsers" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Chrome  •  Edge  •  Opera" Foreground="#CBD5E1" Margin="0,8,0,0"/>
            <TextBlock Text="Uses the Windows hosts layer, so protection applies system-wide." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="Administrator permissions are required to apply Windows-level protection." Foreground="#64748B" Margin="2,18,0,0"/>
  </Grid>
</Window>
